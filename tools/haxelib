#!/bin/sh
# Stands in for haxelib, which the pinned compiler build does not carry (it needs neko): the compiler
# resolves -lib by running `haxelib [--cwd DIR] path LIB...` from PATH, and this answers that one call
# from the checkout's .haxelib/<lib>/.dev files written by tools/setup.sh.
# ponytail: `path` only, haxelib.json read with sed; a real haxelib if more is ever needed.
dir=$PWD
[ "$1" = --cwd ] && { dir=$2; shift 2; }
[ "$1" = path ] || { echo "haxelib: this stub only answers 'path'" >&2; exit 1; }
shift
while [ ! -d "$dir/.haxelib" ]; do
  [ "$dir" = / ] && { echo "haxelib: no .haxelib/ here; run tools/setup.sh" >&2; exit 1; }
  dir=$(dirname "$dir")
done
seen=
emit() {
  case " $seen " in *" $1 "*) return ;; esac
  seen="$seen $1"
  p=$(cat "$dir/.haxelib/$1/.dev") || { echo "haxelib: library $1 is not installed" >&2; exit 1; }
  echo "$p/"
  echo "-D $1=$(sed -n 's/.*"version"[^"]*"\([^"]*\)".*/\1/p' "$p/haxelib.json" | head -n 1)"
  for d in $(tr -d '\n' < "$p/haxelib.json" | sed -n 's/.*"dependencies"[^{]*{\([^}]*\)}.*/\1/p' | grep -o '"[^"]*" *:' | tr -d '": '); do
    emit "$d"
  done
}
for l; do emit "$l"; done
